# Generate a hex password: openssl rand -hex 32
# Hex avoids URL escaping when Compose constructs DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-hex-password
# A DIFFERENT 32-byte hex secret for the restricted API database role.
# Generate independently: openssl rand -hex 32
APP_DB_PASSWORD=replace-with-another-generated-hex-password
IMAGE_PREFIX=ghcr.io/kihiralove/vardorvis-clan-clog
# One image contains Nginx, the API, and optional Discord gateway.
# Replace with the full SHA tag from a successful Images run.
IMAGE_TAG=sha-replace-with-40-character-commit-sha
WEB_PORT=8088
# Production Traefik only: copy compose.traefik.yaml alongside compose.yaml.
# Uncomment COMPOSE_FILE on the server to apply the Traefik labels and networks.
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
CLOG_HOST=
# Set these to existing Traefik startup configuration names if non-default.
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# For host-run Node development; Compose uses db:5432 instead.
DATABASE_URL=postgresql://clog:replace-with-generated-hex-password@127.0.0.1:5432/clog

# Set true to enable staff accounts on /admin (leave false only for unconfigured public/API setups).
AUTH_ENABLED=false
# Verified external proxy IPs/CIDRs (e.g. the Traefik IP), comma separated.
# The bundled app adds its internal Nginx loopback hop; empty trusts no external proxy.
TRUSTED_PROXY_CIDRS=
# Local Docker development: use HTTP loopback; use HTTPS for production.
PUBLIC_ORIGIN=http://127.0.0.1:8088
# First startup creates admin/admin. First login requires a new 12+ character password.
# Later credentials are managed on /admin/account and stored as salted scrypt hashes.
# Generate at least 32 random bytes as hex; rotating invalidates existing sessions.
SESSION_SECRET=
# Enable API intake by setting BOT_API_TOKEN and DISCORD_GUILD_ID together.
# Generate the bot service credential: openssl rand -hex 32
BOT_API_TOKEN=
# Enable the Discord gateway only after all bot credentials are configured.
BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Host-run API only: absolute durable directory; Compose uses its named icon volume.
ICON_STORAGE_PATH=
# Only for manual test-guild command registration; never automatically registered.
DISCORD_TEST_GUILD_ID=
