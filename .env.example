# Generate a hex password: openssl rand -hex 32
# Hex avoids URL escaping when Compose constructs DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-hex-password
IMAGE_PREFIX=ghcr.io/kihiralove/vardorvis-clan-clog
# Replace with the full SHA tag from a successful Images run.
IMAGE_TAG=sha-replace-with-40-character-commit-sha
WEB_PORT=8088
# For host-run Node development; Compose uses db:5432 instead.
DATABASE_URL=postgresql://clog:replace-with-generated-hex-password@127.0.0.1:5432/clog

# Keep false until a Discord app and allowlisted IDs are configured.
AUTH_ENABLED=false
# Explicit trusted reverse-proxy IPs/CIDRs, comma separated; empty trusts none.
TRUSTED_PROXY_CIDRS=
# Auth uses HTTPS, except HTTP loopback for non-production development.
PUBLIC_ORIGIN=https://clog.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://clog.example.com/api/v1/auth/discord/callback
ADMIN_DISCORD_USER_IDS=
# Generate at least 32 random bytes as hex; rotating invalidates existing sessions.
SESSION_SECRET=
BOT_API_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Host-run API only: absolute durable directory; Compose uses its named icon volume.
ICON_STORAGE_PATH=
