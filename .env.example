# Ordinary installation settings; machine secrets are generated in Docker volumes.
IMAGE_NAME=ghcr.io/kihiralove/clan-clog
IMAGE_TAG=sha-replace-with-40-character-commit-sha
WEB_PORT=8088
AUTH_ENABLED=true
PUBLIC_ORIGIN=http://127.0.0.1:8088
TRUSTED_PROXY_CIDRS=

# Optional existing Traefik installation; select the matching Compose overlay.
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
CLOG_HOST=
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional Discord integration. Leave disabled until every required value is set.
BOT_ENABLED=false
BOT_API_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_TEST_GUILD_ID=
BOT_INTAKE_USER_PER_MINUTE=5
BOT_INTAKE_GUILD_PER_MINUTE=60
BOT_SEARCH_USER_PER_MINUTE=30
BOT_SEARCH_GUILD_PER_MINUTE=300

# Advanced secret-file inputs, host development and deployment controls are
# documented in docs/environment.md. Generated secrets never belong in this file.
