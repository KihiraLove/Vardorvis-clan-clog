{
  "name": "@clog/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test src/*.test.ts",
    "test:e2e": "playwright test",
    "test:loading": "playwright test --config playwright.loading.config.ts",
    "test:security": "playwright test --config playwright.security.config.ts",
    "test:stack": "playwright test --config playwright.stack.config.ts"
  },
  "dependencies": {
    "@clog/domain": "1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.1.7"
  },
  "license": "MIT"
}
