{
  "name": "@clog/bot",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "start": "node dist/index.js",
    "register:test": "node dist/register.js test",
    "register:guild": "node dist/register.js guild",
    "build:runtime": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.runtime.json"
  },
  "dependencies": {
    "@clog/database": "*",
    "pg": "^8.16.3",
    "@clog/domain": "*",
    "discord.js": "^14.22.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  },
  "license": "MIT"
}
