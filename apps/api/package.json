{
  "name": "@clog/api",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "dev": "node --env-file=../../.env --watch dist/server.js",
    "start": "node dist/server.js",
    "build:runtime": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.runtime.json"
  },
  "dependencies": {
    "@clog/bot": "*",
    "@clog/database": "*",
    "@clog/domain": "*",
    "@fastify/multipart": "^10.1.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  },
  "license": "MIT"
}
